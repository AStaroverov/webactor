{
    "name": "actorr",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "build": "pnpm -r --filter \"./packages/*\" build",
        "test": "pnpm test:unit && pnpm test:e2e && pnpm test:devtools",
        "test:unit": "pnpm --filter webactor test",
        "test:e2e": "pnpm --filter webactor test:e2e",
        "test:devtools": "pnpm --filter webactor-devtools test",
        "devtools:dev": "pnpm --filter webactor-devtools dev",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "typescript": "^7.0.2"
    }
}
