{
  "name": "webactor",
  "description": "Everything that you need for actor architecture on client",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AStaroverov/actorr.git"
  },
  "author": "AStaroverov",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "npm run build && npm publish",
    "release:beta": "npm run build && npm publish --tag beta"
  },
  "devDependencies": {
    "@apacheli/web-workers": "^2.0.1",
    "@typescript/typescript6": "^6.0.2",
    "@types/node": "^26.1.1",
    "@vitest/ui": "^4.1.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "web-locks": "0.0.8"
  }
}
