{
    "include": ["src", "tests", "build.mjs", "playwright.config.ts"],
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
        "skipDefaultLibCheck": true,
        "moduleResolution": "bundler",
        "types": ["chrome", "node"],
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "paths": {
            "webactor": ["../webactor/src/index.ts"]
        }
    }
}
