{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "paths": {
            "webactor": ["../src/index.ts"]
        }
    },
    "include": ["src", "tests", "playwright.config.ts", "vite.config.ts"]
}
